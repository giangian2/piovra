#!/usr/bin/env bash
# Runs the Maven wrapper inside the JDK 25 development container.
#
#   ./scripts/mvnd clean install
#   ./scripts/mvnd -pl services/piovra-publication test
#
# The project requires Java 25 (JEP 491: no virtual-thread pinning on synchronized blocks).
# If the host already has a JDK 25 this script is unnecessary: just use ./mvnw.
#
# A thin wrapper over devshell so that both share one image, one user and one Maven cache
# volume: running them as different users leaves the cache half root-owned.
set -euo pipefail
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/devshell" ./mvnw -B "$@"
