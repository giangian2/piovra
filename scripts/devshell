#!/usr/bin/env bash
# Opens a shell in the Piovra development container (JDK 25), with the workspace mounted.
#
#   ./scripts/devshell            # interactive shell
#   ./scripts/devshell mvnw test  # run one command and exit
#
# This is the plain-Docker alternative to the devcontainer: same image, no IDE involved.
set -euo pipefail

IMAGE="${PIOVRA_DEV_IMAGE:-piovra-dev}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! docker image inspect "${IMAGE}" >/dev/null 2>&1 || [ "${PIOVRA_REBUILD:-0}" = "1" ]; then
  echo "==> building ${IMAGE}"
  docker build -q -f "${ROOT}/.devcontainer/Dockerfile" -t "${IMAGE}" "${ROOT}" >/dev/null
fi

docker volume inspect piovra-m2 >/dev/null 2>&1 || docker volume create piovra-m2 >/dev/null

# The container talks to the HOST Docker daemon (Testcontainers). Permission on the socket is
# a group-id question, and that gid differs on every machine, so it is read here instead of
# being baked into the image.
DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo '')"
GROUP_ARGS=()
[ -n "${DOCKER_GID}" ] && GROUP_ARGS=(--group-add "${DOCKER_GID}")

TTY_FLAGS=()
[[ -t 0 && -t 1 ]] && TTY_FLAGS=(-it)

exec docker run --rm "${TTY_FLAGS[@]}" \
  --name "piovra-devshell-$$" \
  -v "${ROOT}:/workspaces/piovra" \
  -v piovra-m2:/home/piovra/.m2 \
  -v /var/run/docker.sock:/var/run/docker.sock \
  "${GROUP_ARGS[@]}" \
  --add-host=host.docker.internal:host-gateway \
  -e TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal \
  -e TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock \
  -e KAFKA_BOOTSTRAP=host.docker.internal:9092 \
  -e PIOVRA_DB_URL=jdbc:postgresql://host.docker.internal:5432/piovra \
  -e REDIS_URL=redis://host.docker.internal:6379 \
  -e S3_ENDPOINT=http://host.docker.internal:9000 \
  -p 8080:8080 -p 8081:8081 -p 8082:8082 -p 8083:8083 \
  -w /workspaces/piovra \
  "${IMAGE}" \
  "${@:-bash}"
