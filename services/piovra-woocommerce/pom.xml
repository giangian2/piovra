<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.piovra</groupId>
    <artifactId>piovra-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>piovra-woocommerce</artifactId>
  <name>Piovra :: woocommerce</name>
  <description>Hosts the WooCommerce driver: order polling, cursors, rate limiting.</description>

  <dependencies>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-driver-woocommerce</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-kafka-support</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-crosscutting</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Just Jackson, not the web starter: this module has no REST endpoint. The outbox writer
         needs an ObjectMapper bean, and in Boot 4 that autoconfiguration lives in its own module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- Spring Boot 4 ships one autoconfiguration module per technology: without this artifact
         flyway-core sits on the classpath and nothing ever runs it, so Hibernate validates against
         an empty schema. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- The raw marketplace payload contains personal data: it goes to object storage and only its
         URI travels on Kafka (docs/07-order-flow.md). MinIO locally, real S3 in production. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>
</project>
