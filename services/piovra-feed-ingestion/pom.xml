<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.piovra</groupId>
    <artifactId>piovra-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>piovra-feed-ingestion</artifactId>
  <name>Piovra :: feed-ingestion</name>
  <description>Feed acquisition over HTTP and SFTP, immutable archiving.</description>

  <dependencies>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-kafka-support</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.piovra</groupId>
      <artifactId>piovra-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- S3-compatible object storage for the immutable raw feed archive (docs/05-feed-flow.md):
         MinIO locally via endpointOverride, real S3 in production, same client either way. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <!-- Optional: only for the HealthIndicator/Health types. The assembling app (apps/piovra-feed)
         already depends on spring-boot-starter-actuator to actually expose and register it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
